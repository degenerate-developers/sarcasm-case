{
	"trailingComma": "es5",
	"printWidth": 100,
	"useTabs": true,
	"tabWidth": 2,
	"semi": true,
	"singleQuote": true,
	"bracketSpacing": true,
	"overrides": [
		{
			"files": ["**/*.sh"],
			"options": {
				"tabWidth": 2,
				"useTabs": true,
				"printWidth": 100
			}
		},
		{
			"files": ["**/*.yml"],
			"options": {
				"tabWidth": 2,
				"useTabs": true
			}
		}
	]
}
